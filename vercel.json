{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api/events.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!baidu_verify_).*)",
      "has": [
        {
          "type": "host",
          "value": "www.airesetclock.com"
        }
      ],
      "destination": "https://airesetclock.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!baidu_verify_).*)\\.html",
      "destination": "/:path",
      "permanent": true
    },
    {
      "source": "/:path*/index",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    },
    {
      "source": "/:path*",
      "destination": "/:path*/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 1 * * *"
    }
  ]
}
